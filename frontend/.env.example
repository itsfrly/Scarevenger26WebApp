# Copy to .env.local and fill from the stack outputs:
#   aws cloudformation describe-stacks --region us-east-1 \
#     --stack-name ScavengerHuntStack --query "Stacks[0].Outputs" --output table

# CloudFront distribution URL. Dev proxies /api and /media here so the browser
# stays same-origin, matching production.
VITE_PROXY_TARGET=https://xxxxxxxx.cloudfront.net

# Cognito hosted UI base and app client. Both are public values.
VITE_AUTH_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
VITE_AUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AUTH_DOMAIN=https://scarevenger.auth.us-east-1.amazoncognito.com
