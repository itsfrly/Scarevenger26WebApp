{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws",
      "aws-cn"
    ],
    "scarevenger:domainName": "scarevenger.app",
    "scarevenger:googleClientId": "926452502387-soh0sr8iv6jd8deoidar50b81iupprvp.apps.googleusercontent.com",
    "scarevenger:customAuthDomain": true,
    "scarevenger:blockManagedRules": false,
    "scarevenger:snapshotsEnabled": false,
    "scarevenger:alarmEmail": "andrew@gofarley.com",
    "scarevenger:repository": "itsfrly/Scarevenger26WebApp",
    "scarevenger:deployBranch": "main",
    "scarevenger:githubOidcProviderExists": false
  }
}
